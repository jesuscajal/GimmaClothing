# Copiar a apps/storefront/.env.local en el servidor (producción).
# Reemplazar TU_DOMINIO.com y la publishable key del admin Medusa.

NODE_ENV=production

NEXT_PUBLIC_BASE_URL=https://TU_DOMINIO.com
NEXT_PUBLIC_MEDUSA_BACKEND_URL=https://api.TU_DOMINIO.com
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_reemplazar_desde_admin_medusa
NEXT_PUBLIC_DEFAULT_REGION=ar

# WhatsApp real de Gimma (sin + ni espacios). Ej: 54911XXXXXXXX
NEXT_PUBLIC_DEMO_WHATSAPP=5491123456789

# demo = inicio en /demo (diseño). production = inicio en tienda Medusa real (/ar)
NEXT_PUBLIC_GIMMA_ROOT=demo

NEXT_PUBLIC_STRIPE_KEY=
MEDUSA_CLOUD_S3_HOSTNAME=
MEDUSA_CLOUD_S3_PATHNAME=
