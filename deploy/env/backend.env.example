# Copiar a apps/backend/.env en el servidor (producción).
# Reemplazar TU_DOMINIO.com y los secretos.

NODE_ENV=production

# Tienda pública
STORE_CORS=https://TU_DOMINIO.com,https://www.TU_DOMINIO.com

# Panel admin Medusa (servido en api.TU_DOMINIO.com/app)
ADMIN_CORS=https://api.TU_DOMINIO.com
AUTH_CORS=https://api.TU_DOMINIO.com,https://TU_DOMINIO.com,https://www.TU_DOMINIO.com

# Debe coincidir con deploy/env/docker.env
DATABASE_URL=postgres://gimma:TU_PASSWORD_POSTGRES@127.0.0.1:5432/medusa-store?sslmode=disable
DB_NAME=medusa-store
REDIS_URL=redis://127.0.0.1:6379

# Generar con: openssl rand -hex 32
JWT_SECRET=cambiar_por_secreto_largo
COOKIE_SECRET=cambiar_por_otro_secreto_largo

# false hasta tener HTTPS (Cloudflare). Con SSL: true
MEDUSA_COOKIE_SECURE=false
