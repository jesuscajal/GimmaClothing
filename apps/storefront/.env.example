# Copiá este archivo a .env.local y ejecutá npm run env:sync desde la raíz
# (después de npm run db:setup) para obtener la publishable key real.

NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_reemplazar_tras_db_setup
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_DEFAULT_REGION=ar
NEXT_PUBLIC_BASE_URL=http://localhost:8000

# demo = inicio en /demo | production = tienda real /ar/inicio
NEXT_PUBLIC_GIMMA_ROOT=production

NEXT_PUBLIC_DEMO_WHATSAPP=5493705244120
NODE_ENV=development
